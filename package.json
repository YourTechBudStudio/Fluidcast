{
  "name": "fluidcast",
  "version": "0.0.0",
  "private": true,
  "description": "Voice-and-visual SDKs for conversational coordination with existing agents.",
  "author": "YourTechBud",
  "type": "module",
  "scripts": {
    "backend:dev": "pnpm --filter '@fluidcast/backend^...' build && pnpm --filter @fluidcast/backend dev",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "build:libs": "pnpm -r --workspace-concurrency=1 --filter '!@fluidcast/web' --if-present build",
    "chatgpt:login": "pnpm --filter @fluidcast/backend chatgpt:login",
    "check": "pnpm lint && pnpm check:pure && pnpm typecheck && pnpm test && pnpm format:check",
    "check:pure": "node scripts/check-pure-exports.mjs",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --threads=8 --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --threads=8 --fix --no-error-on-unmatched-pattern",
    "test": "pnpm build:libs && pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm build:libs && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "web:dev": "pnpm --filter '@fluidcast/web^...' build && pnpm --filter '@fluidcast/web...' --parallel --if-present dev"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "oxc-parser": "^0.151.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.9.1"
}
