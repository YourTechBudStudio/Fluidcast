{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@yourtechbudstudio/fluidcast-typescript-config/react.json",
  "compilerOptions": {
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
