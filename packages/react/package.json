{
  "name": "@yourtechbudstudio/fluidcast-react",
  "version": "0.0.2",
  "license": "Apache-2.0",
  "author": "YourTechBud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourTechBudStudio/Fluidcast.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/build-css.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:css": "node --watch-path=src --watch-path=scripts scripts/build-css.mjs",
    "dev:js": "tsc --watch --preserveWatchOutput --project tsconfig.build.json",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"tests/*.test.mjs\" \"scripts/*.test.mjs\" && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@yourtechbudstudio/fluidcast-client": "workspace:*",
    "@yourtechbudstudio/fluidcast-core": "workspace:*",
    "@yourtechbudstudio/fluidcast-harness": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-agent": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-ask": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-show": "workspace:*",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.47.0",
    "markdown-it": "catalog:",
    "mermaid": "catalog:",
    "motion": "^13.4.2"
  },
  "devDependencies": {
    "@effect/atom-react": "^4.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "effect": "catalog:",
    "happy-dom": "^21.0.1",
    "oxc-parser": "^0.151.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/atom-react": "^4.0.2",
    "effect": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
