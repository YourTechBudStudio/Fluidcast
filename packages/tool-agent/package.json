{
  "name": "@yourtechbudstudio/fluidcast-tool-agent",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "default": "./dist/claude/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "tsc --watch --preserveWatchOutput --project tsconfig.build.json",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "0.127.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-core": "workspace:*",
    "@yourtechbudstudio/fluidcast-harness": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-ask": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-show": "workspace:*",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@yourtechbudstudio/fluidcast-core": "workspace:*",
    "@yourtechbudstudio/fluidcast-harness": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-ask": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-show": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
