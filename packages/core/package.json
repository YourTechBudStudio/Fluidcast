{
  "name": "@yourtechbudstudio/fluidcast-core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "tsc --watch --preserveWatchOutput --project tsconfig.build.json",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
