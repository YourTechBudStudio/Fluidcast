{
  "name": "@yourtechbudstudio/fluidcast-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "YourTechBud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourTechBudStudio/Fluidcast.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "default": "./dist/generation/index.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "default": "./dist/speech/index.js"
    },
    "./speech/openai": {
      "types": "./dist/speech/openai.d.ts",
      "default": "./dist/speech/openai.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "tsc --watch --preserveWatchOutput --project tsconfig.build.json",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@effect/ai-openai": "catalog:",
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/ai-openai": "catalog:",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/ai-openai": {
      "optional": true
    }
  }
}
