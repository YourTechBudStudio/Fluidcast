{
  "name": "@yourtechbudstudio/fluidcast-harness",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "YourTechBud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourTechBudStudio/Fluidcast.git",
    "directory": "packages/harness"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/session/protocol.d.ts",
      "default": "./dist/session/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "tsc --watch --preserveWatchOutput --project tsconfig.build.json",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@yourtechbudstudio/fluidcast-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
