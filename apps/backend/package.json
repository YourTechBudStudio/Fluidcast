{
  "name": "@fluidcast/backend",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "chatgpt:login": "node src/chatgpt-login.ts",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "node src/dev.ts --config ../../fluidcast.yaml",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "4.0.0-rc.117",
    "@effect/platform-node": "catalog:",
    "@fluidcast/app-contract": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@yourtechbudstudio/fluidcast-core": "workspace:*",
    "@yourtechbudstudio/fluidcast-harness": "workspace:*",
    "@yourtechbudstudio/fluidcast-presets": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-agent": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-ask": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-show": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
