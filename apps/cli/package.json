{
  "name": "@fluidcast/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Serves the Fluidcast reference backend and web player from one standalone process.",
  "bin": {
    "fluidcast": "dist/fluidcast.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "bundle": "pnpm --filter @fluidcast/cli^... --filter @fluidcast/web^... build && pnpm --filter @fluidcast/web build && node scripts/bundle.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "start": "node src/main.ts serve --config ../../fluidcast.yaml --web-root ../web/dist",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@fluidcast/backend": "workspace:*",
    "@types/node": "catalog:",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rolldown": "1.2.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
