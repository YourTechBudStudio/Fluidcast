    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@yourtechbudstudio/fluidcast-client": "workspace:*",
    "@yourtechbudstudio/fluidcast-core": "workspace:*",
    "@yourtechbudstudio/fluidcast-harness": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-ask": "workspace:*",
    "@yourtechbudstudio/fluidcast-tool-show": "workspace:*",
    "effect": "catalog:",
    "lucide-react": "^1.47.0",
    "markdown-it": "catalog:",
    "mermaid": "catalog:",
    "motion": "^13.4.2",
    "react": "^19.3.0",
