{
  "name": "@fluidcast/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "vite",
    "fix": "oxlint . --fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "node --test \"tests/*.test.mjs\" && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
