    "@vitejs/plugin-react": "^6.1.1",
    "@yourtechbudstudio/fluidcast-typescript-config": "workspace:*",
    "oxc-parser": "^0.151.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
