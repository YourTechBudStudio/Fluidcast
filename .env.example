# Copy to .env next to your fluidcast.yaml. Variables in the real environment take precedence.

# Key for the openai provider (the variable named by providers.openai.apiKeyEnv).
FLUIDCAST_OPENAI_API_KEY=

# Key for the openai-compatible provider (providers.openai-compatible.apiKeyEnv), if you use it.
FLUIDCAST_OPENAI_COMPATIBLE_API_KEY=

# Key for the anthropic provider (providers.anthropic.apiKeyEnv), if you use it: a Claude Platform
# (console) API key. Named apart from ANTHROPIC_API_KEY, which Claude Code itself reads.
FLUIDCAST_ANTHROPIC_API_KEY=
